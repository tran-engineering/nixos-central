# The `nixos-central` command: runs the subcommands registered in
# `nixos-central.commands` (option.nix), prints their help, offers them in a
# menu (gum) when run without arguments in a terminal, and brings bash, zsh and
# fish completions for them. Built by modules/base/command.nix on NixOS and by
# modules/home/command.nix on standalone homes.
{
  lib,
  writeShellApplication,
  writeTextDir,
  symlinkJoin,
  gum,
  # Evaluated `nixos-central.commands`.
  commands,
}:
let
  inherit (lib)
    concatMapStrings
    concatStringsSep
    escapeShellArg
    escapeShellArgs
    filterAttrs
    getExe
    mapAttrsToList
    optionalString
    stringLength
    ;

  subcommands = lib.sort (a: b: if a.order != b.order then a.order < b.order else a.name < b.name) (
    mapAttrsToList (name: c: c // { inherit name; }) commands
  );

  padTo = width: s: s + lib.concatStrings (lib.replicate (width - stringLength s) " ");
  maxWidth = strings: lib.foldl' lib.max 0 (map stringLength strings);

  synopsis = c: c.name + optionalString (c.usage != "") " ${c.usage}";
  helpWidth = maxWidth (map synopsis subcommands);
  helpLines = map (c: "  ${padTo helpWidth (synopsis c)}  ${c.description}") subcommands;

  menuWidth = maxWidth (map (c: c.name) subcommands);
  # The selected line is cut back to its first word, the subcommand.
  menuItems = map (c: "${padTo menuWidth c.name}  ${c.description}") (
    builtins.filter (c: c.chooser) subcommands
  );

  script = writeShellApplication {
    name = "nixos-central";
    runtimeInputs = [ gum ];
    text = ''
      help() {
        echo "usage: nixos-central <subcommand> [arguments]"
        echo
        echo "Subcommands:"
        printf '%s\n' ${escapeShellArgs helpLines}
        echo
        echo "Run without arguments in a terminal to pick a subcommand from a menu."
      }

      if [ $# -eq 0 ]; then
        if [ -t 0 ] && [ -t 1 ]; then
          # Cancelled (Escape, Ctrl-C): gum's non-zero status, nothing runs.
          choice=$(gum choose --header "nixos-central: what do you want to do?" ${escapeShellArgs menuItems}) || exit
          set -- "''${choice%% *}"
        else
          help >&2
          exit 2
        fi
      fi

      sub=$1
      shift
      case "$sub" in
        help | -h | --help)
          help
          ;;
      ${
        concatMapStrings (
          c: "  ${escapeShellArg c.name})\n    exec ${getExe c.package} \"$@\"\n    ;;\n"
        ) subcommands
      }  *)
          echo "nixos-central: '$sub' is not a subcommand." >&2
          echo >&2
          help >&2
          exit 2
          ;;
      esac
    '';
  };

  # Completion: one branch per subcommand with completions. `""` words are
  # offered directly after the subcommand, other keys once that word was typed.
  withCompletions = filterAttrs (_: words: words != [ ]);
  keyed =
    c: f:
    concatStringsSep "\n" (
      mapAttrsToList (key: words: f key (escapeShellArgs words)) (withCompletions c.completions)
    );
  completing = builtins.filter (c: withCompletions c.completions != { }) subcommands;

  bash = writeTextDir "share/bash-completion/completions/nixos-central" ''
    # Generated by nixos-central-internal/command.
    _nixos_central() {
      local cur=''${COMP_WORDS[COMP_CWORD]}
      local -a cands=() args=() out=()
      if [ "$COMP_CWORD" -eq 1 ]; then
        cands=(${escapeShellArgs (map (c: c.name) subcommands)})
      else
        args=("''${COMP_WORDS[@]:2:COMP_CWORD-2}")
        case "''${COMP_WORDS[1]}" in
    ${
      concatMapStrings (c: ''
              ${escapeShellArg c.name})
        ${keyed c (
          key: words:
          if key == "" then
            "        if [ \"$COMP_CWORD\" -eq 2 ]; then cands+=(${words}); fi"
          else
            "        if _nixos_central_typed ${escapeShellArg key}; then cands+=(${words}); fi"
        )}
                ;;
      '') completing
    }    esac
      fi
      local c
      for c in "''${cands[@]}"; do
        _nixos_central_typed "$c" || out+=("$c")
      done
      mapfile -t COMPREPLY < <(compgen -W "''${out[*]}" -- "$cur")
    }
    # Whether a word was typed after the subcommand (args of _nixos_central).
    _nixos_central_typed() {
      local a
      for a in "''${args[@]}"; do
        [ "$a" = "$1" ] && return 0
      done
      return 1
    }
    complete -F _nixos_central nixos-central
  '';

  zsh = writeTextDir "share/zsh/site-functions/_nixos-central" ''
    #compdef nixos-central
    # Generated by nixos-central-internal/command.
    local -a subcommands cands args out
    subcommands=(${escapeShellArgs (map (c: "${c.name}:${c.description}") subcommands)})
    if (( CURRENT == 2 )); then
      _describe -t subcommands 'nixos-central subcommand' subcommands
      return
    fi
    args=("''${(@)words[3,CURRENT-1]}")
    case $words[2] in
    ${
      concatMapStrings (c: ''
          ${escapeShellArg c.name})
        ${keyed c (
          key: words:
          if key == "" then
            "    if (( CURRENT == 3 )); then cands+=(${words}); fi"
          else
            "    if (( \${args[(Ie)${escapeShellArg key}]} )); then cands+=(${words}); fi"
        )}
            ;;
      '') completing
    }esac
    local c
    for c in $cands; do
      (( ''${args[(Ie)$c]} )) || out+=($c)
    done
    compadd -a out
  '';

  fish = writeTextDir "share/fish/vendor_completions.d/nixos-central.fish" ''
    # Generated by nixos-central-internal/command.
    function __nixos_central_complete
        set -l tokens (commandline -xpc)
        set -l n (count $tokens)
        if test $n -eq 1
    ${
      concatMapStrings (
        c: "        printf '%s\\t%s\\n' ${escapeShellArg c.name} ${escapeShellArg c.description}\n"
      ) subcommands
    }        return
        end
        set -l args
        if test $n -gt 2
            set args $tokens[3..-1]
        end
        set -l cands
        switch $tokens[2]
    ${
      concatMapStrings (c: ''
              case ${escapeShellArg c.name}
        ${keyed c (
          key: words:
          if key == "" then
            "            if test $n -eq 2; set -a cands ${words}; end"
          else
            "            if contains -- ${escapeShellArg key} $args; set -a cands ${words}; end"
        )}
      '') completing
    }    end
        for c in $cands
            contains -- $c $args; or echo $c
        end
    end
    complete -c nixos-central -f -a '(__nixos_central_complete)'
  '';
in
symlinkJoin {
  name = "nixos-central";
  paths = [
    script
    bash
    zsh
    fish
  ];
  meta.mainProgram = "nixos-central";
  passthru = { inherit menuItems; };
}
