// niri config for the SDDM login screen (the greeter runs as its only window).
// The cursor theme is installed by modules/base/sddm.nix.
hotkey-overlay {
    skip-at-startup
}
cursor {
    xcursor-theme "catppuccin-mocha-dark-cursors"
    xcursor-size 24
}
animations {
    off
}
window-rule {
    open-fullscreen true
}
xwayland-satellite {
    off
}
